        <mxCell id="hosttitle" parent="host" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" value="&lt;b style=&quot;font-size:14px&quot;&gt;SRV-NEXA-01&lt;/b&gt;&lt;br&gt;Servidor físico&lt;br&gt;Windows Server 2022 Hyper-V" vertex="1">
          <mxGeometry height="62" width="180" x="140" y="8" as="geometry" />
        </mxCell>
        <mxCell id="vmdc" parent="host" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#0078d4;strokeWidth=2;" value="&lt;b style=&quot;font-size:13px&quot;&gt;VM-DC-01&lt;/b&gt;&lt;br&gt;Windows Server 2022 Std&lt;br&gt;&lt;i&gt;2 vCPU / 8 GB RAM / 120 GB (RAID 1)&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Serviços:&lt;/b&gt;&lt;br&gt;• AD DS: autenticação centralizada, GPO e controle de acesso (60 funcionários)&lt;br&gt;• DNS e DHCP: nexabiomech.local e IPs por VLAN&lt;br&gt;• Print Server: filas e cotas das 6 impressoras Brother (4 andares)&lt;br&gt;&lt;i&gt;(DNS/DHCP e Print compartilham os recursos da VM)&lt;/i&gt;" vertex="1">
          <mxGeometry height="300" width="200" x="20" y="85" as="geometry" />
        </mxCell>
        <mxCell id="vmdev" parent="host" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;b style=&quot;font-size:13px&quot;&gt;VM-DEV-MON&lt;/b&gt;&lt;br&gt;Ubuntu Server 24.04 LTS&lt;br&gt;&lt;i&gt;4 vCPU / 12 GB RAM / 80 GB SO + 1 TB Dados (RAID 10)&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Serviços:&lt;/b&gt;&lt;br&gt;• Repositório Git: código-fonte e firmwares das próteses (16 usuários de Eng. Eletrônica e Dev. de Software)&lt;br&gt;• Monitoramento SNMP/ICMP 24/7: servidor, switches, APs e alertas ambientais da sala de TI (6 usuários de TI)&lt;br&gt;&lt;i&gt;(Monitoramento compartilha os recursos da VM)&lt;/i&gt;" vertex="1">
          <mxGeometry height="300" width="200" x="240" y="85" as="geometry" />
        </mxCell>
        <mxCell id="vmfs" parent="host" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#0078d4;strokeWidth=2;" value="&lt;b style=&quot;font-size:13px&quot;&gt;VM-FS-01&lt;/b&gt;&lt;br&gt;Windows Server 2022 Std&lt;br&gt;&lt;i&gt;4 vCPU / 16 GB RAM / 80 GB SO + 7 TB Dados (RAID 10)&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Serviços:&lt;/b&gt;&lt;br&gt;• File Server (SMB): modelos CAD 3D, esquemas eletrônicos, relatórios de testes e documentos administrativos&lt;br&gt;• Backup Server: backups automatizados (Veeam Community/Essentials) para storage externo e nuvem&lt;br&gt;&lt;i&gt;(Backup compartilha os recursos da VM)&lt;/i&gt;" vertex="1">
